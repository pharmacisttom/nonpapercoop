{
  "name": "nonpapercoop-test",
  "version": "0.2.0",
  "scripts": {
    "start": "node --env-file=.env apps/api/src/server.js",
    "test": "node --test tests/unit/*.test.js tests/integration/*.test.js",
    "test:e2e": "node scripts/test-e2e.mjs",
    "test:mysql": "node --test tests/mysql.test.js",
    "check": "node scripts/check.mjs",
    "test:local-db": "node scripts/test-local-db.mjs",
    "test:enterprise": "node --env-file=.env --test --test-concurrency=1 tests/enterprise/*.test.js",
    "openapi": "node scripts/generate-openapi.mjs",
    "scan:secrets": "node scripts/secret-scan.mjs"
  },
  "keywords": [],
  "author": "",
  "license": "UNLICENSED",
  "description": "NonPaperCoop TEST cooperative document workspace",
  "dependencies": {
    "@fontsource/noto-sans-thai": "5.3.0",
    "datatables.net": "3.1.5",
    "datatables.net-dt": "3.1.5",
    "express": "5.3.0",
    "express-rate-limit": "8.7.4",
    "express-session": "1.19.0",
    "google-auth-library": "11.3.4",
    "helmet": "8.3.0",
    "jquery": "3.7.1",
    "multer": "2.5.0",
    "mysql2": "3.24.6",
    "sweetalert2": "11.26.25",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "1.65.1",
    "prettier": "3.10.1",
    "supertest": "7.3.2"
  },
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=26 <27"
  }
}
